# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server-only. Never prefix this with NEXT_PUBLIC_. Prefer a Supabase secret key.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_server_only_key
# Public base URL used to create invitation links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protects the scheduled Vercel deadline-reminder endpoint. Use a long random secret.
CRON_SECRET=replace_with_a_long_random_secret

# Legacy migration support only: retain the ORIGINAL 32-byte base64 key if
# older college AI settings were encrypted with it. Changing or generating a
# new key will NOT decrypt old settings.
# New keys saved AFTER SQL migration 032 use Supabase Vault instead.
# OPENROUTER_ENCRYPTION_KEY=existing_original_32_byte_base64_key
